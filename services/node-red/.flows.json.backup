    {
        "id": "f96e941f8416b7a5",
        "type": "function",
        "z": "74e9e1df8aa29fe1",
        "name": "แปลงRAW_data",
        "func": "// แยกข้อความด้วยคอมมา\nvar d = msg.payload.split(\",\");\n\n// สร้าง Object ใหม่ (เรียงตามลำดับใน ESP32)\nmsg.payload = {\n    \"rpm\": parseInt(d[0]),\n    \"amp\": parseFloat(d[1]),\n    \"volt\": parseFloat(d[2]),\n    \"trq\": parseInt(d[3]),\n    \"mode\": d[4],\n    \"igbtC\": parseInt(d[5]),\n    \"motC\": parseInt(d[6]),\n    \"err\": parseInt(d[7]),\n    \"warn\": parseInt(d[8]),\n    \"L_REGEN\": parseInt(d[9]),\n    \"L_ERR\": parseInt(d[10]),\n    \"L_WARN\": parseInt(d[11]),\n    \"L_OK\": parseInt(d[12]),\n    \"L_PUMP\": parseInt(d[13]),\n    \"drive_ena\": parseInt(d[14])\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 720,
        "y": 500,
        "wires": [
            [
                "743cb60fbf076136",
                "cee710f172f954b2",
                "31b62781d2dadad9",
                "dd170ff4472cdfd4",

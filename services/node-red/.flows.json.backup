    {
        "id": "7c1566e089fa2dd2",
        "type": "function",
        "z": "74e9e1df8aa29fe1",
        "name": "แปลง RPM ",
        "func": "// --- Configuration ---\nconst MAX_RPM = 5500; \n\n// 1. รับค่าดิบจาก Buffer/Payload\nlet raw = msg.payload;\n\n// 2. คำนวณ RPM: (ค่าดิบ / 32767) * Max RPM\n// คงค่าบวกลบไว้ตามที่ต้องการ\nlet rpmActual = (raw / 32767) * MAX_RPM;\n\n// 3. ส่งค่ากลับในรูปแบบ Object (ปัดเศษเป็นจำนวนเต็ม)\nmsg.payload = Math.round(rpmActual);\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1590,
        "y": 320,
        "wires": [
            [
                "66d1712b23cc1030",
                "f45d2881cddb3f6e",
                "834b2adc76dc0d0f"
            ]
        ]
    },
    {
        "id": "702054133e265937",
        "type": "function",
        "z": "74e9e1df8aa29fe1",
        "name": "แปลง amp",
        "func": "// --- ตั้งค่ากระแสสูงสุด (Peak Current) ของกล่อง Bamocar ---\n// ตรวจสอบจาก Model กล่อง หรือค่า I-max ในโปรแกรม NDrive\nconst MAX_CURRENT_LIMIT = 212.1; \n\n// ดึงค่า raw data\nlet raw = msg.payload;\n\n// 2. คำนวณเป็นหน่วย Amperes (Arms)\n// สูตร: (ค่าดิบ / 32767) * ค่ากระแสสูงสุด\nlet realAmp = (raw / 32767) * MAX_CURRENT_LIMIT;\n\n// 3. ส่งค่าออกไป (ปัดทศนิยม 1 ตำแหน่งเพื่อให้ดูสวยงาม)\nmsg.payload = parseFloat(realAmp.toFixed(1));\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1590,
        "y": 360,
        "wires": [
            [
                "f79587f34e110913"
            ]
        ]
    },
    {
        "id": "f8e88f427450a1ef",
        "type": "function",
        "z": "74e9e1df8aa29fe1",
        "name": "แปลง igbt_temp",
        "func": "// ดึงค่า Input จาก msg.payload (เช่นค่า 24775)\nlet x = msg.payload;\n\n// ตารางข้อมูลอ้างอิง [Value, Temp]\nconst table = [\n    [16308, -30], [16387, -25], [16487, -20], [16609, -15], [16757, -10],\n    [16938, -5], [17151, 0], [17400, 5], [17688, 10], [18017, 15],\n    [18387, 20], [18797, 25], [19247, 30], [19733, 35], [20250, 40],\n    [20793, 45], [21357, 50], [21933, 55], [22515, 60], [23097, 65],\n    [23671, 70], [24232, 75], [24775, 80], [25296, 85], [25792, 90],\n    [26261, 95], [26702, 100], [27114, 105], [27497, 110], [27851, 115],\n    [28179, 120], [28480, 125]\n];\n\nlet temp = 0;\n\n// ตรวจสอบค่าขอบ (Out of bounds)\nif (x <= table[0][0]) {\n    temp = table[0][1];\n} else if (x >= table[table.length - 1][0]) {\n    temp = table[table.length - 1][1];\n} else {\n    // วนลูปหาช่วงเพื่อ Interpolate\n    for (let i = 0; i < table.length - 1; i++) {\n        let x0 = table[i][0];\n        let y0 = table[i][1];\n        let x1 = table[i + 1][0];\n        let y1 = table[i + 1][1];\n\n        if (x >= x0 && x <= x1) {\n            // สมการ Interpolation: y = y0 + (x - x0) * (y1 - y0) / (x1 - x0)\n            temp = y0 + (x - x0) * (y1 - y0) / (x1 - x0);\n            break;\n        }\n    }\n}\n\n// ส่งค่าที่คำนวณได้ออกไป (ปัดเศษทศนิยม 2 ตำแหน่ง)\nmsg.payload = parseFloat(temp.toFixed(2));\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1620,
        "y": 560,
        "wires": [
            [
                "ed6fef526b40e5c3"
            ]
        ]
    },
    {
        "id": "afd5802324f11c77",
        "type": "function",
        "z": "74e9e1df8aa29fe1",
        "name": "แปลง motor_temp",
        "func": "// 1. แปลง msg.payload จาก String ให้เป็นตัวเลข (Number)\nlet raw = Number(msg.payload);\n\n\n// จุดอ้างอิง\nconst x1 = 11446; // 25 C\nconst y1 = 30;\nconst x2 = 16000; // 60 C\nconst y2 = 100;\n\n// 3. คำนวณ (ตอนนี้ raw เป็นตัวเลขแน่นอนแล้ว)\nlet celsius = y1 + (raw - x1) * (y2 - y1) / (x2 - x1);\n\n// 4. ส่งออกค่าที่คำนวณได้\nmsg.payload = Number(celsius.toFixed(2));\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1630,
        "y": 600,
        "wires": [
            [
                "d4c69ed5d02695b7"
            ]
        ]
    },

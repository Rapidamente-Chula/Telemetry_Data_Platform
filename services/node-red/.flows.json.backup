    {
        "id": "37250efa411af936",
        "type": "function",
        "z": "74e9e1df8aa29fe1",
        "name": "แปลง volt",
        "func": "// --- ตั้งค่ากระแสสูงสุด (Peak Current) ของกล่อง Bamocar ---\n// ตรวจสอบจาก Model กล่อง หรือค่า I-max ในโปรแกรม NDrive\nconst MAX_VOLT_LIMIT = 200; \n\n// ดึงค่า raw data\nlet raw = msg.payload;\n\n// 2. คำนวณเป็นหน่วย Amperes (Arms)\n// สูตร: (ค่าดิบ / 32767) * ค่ากระแสสูงสุด\nlet realAmp = (raw / 32767) * MAX_VOLT_LIMIT;\n\n// 3. ส่งค่าออกไป (ปัดทศนิยม 1 ตำแหน่งเพื่อให้ดูสวยงาม)\nmsg.payload = parseFloat(realAmp.toFixed(1));\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1580,
        "y": 400,
        "wires": [
            [
                "63c5af3c1f619d9a"
            ]
        ]
    },
    {
        "id": "ab8c982cb3dcc4e9",
        "type": "function",
        "z": "74e9e1df8aa29fe1",
        "name": "แปลง torque",
        "func": "// --- ตั้งค่ากระแสสูงสุด (Peak Current) ของกล่อง Bamocar ---\n// ตรวจสอบจาก Model กล่อง หรือค่า I-max ในโปรแกรม NDrive\nconst MAX_TORQUE_LIMIT = 125; \n\n// ดึงค่า raw data\nlet raw = msg.payload;\n\n// 2. คำนวณเป็นหน่วย Amperes (Arms)\n// สูตร: (ค่าดิบ / 32767) * ค่ากระแสสูงสุด\nlet realAmp = (raw / 32767) * MAX_TORQUE_LIMIT;\n\n// 3. ส่งค่าออกไป (ปัดทศนิยม 1 ตำแหน่งเพื่อให้ดูสวยงาม)\nmsg.payload = parseFloat(realAmp.toFixed(1));\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1590,

    {
        "id": "f45d2881cddb3f6e",
        "type": "function",
        "z": "74e9e1df8aa29fe1",
        "name": "RPM to Velocity **ต้องเช็คอัตราทดไหม่",
        "func": "// --- กำหนดค่าคงที่ ---\nconst diameter = 0.4;      // เส้นผ่านศูนย์กลางล้อ (เมตร)\nconst finalRatio = 2;    // อัตราทดเฟืองท้าย (เช่น 2:1)\n\n// --- การคำนวณ ---\nconst engineRpm = msg.payload;         // รับค่า RPM ของเครื่องยนต์/มอเตอร์\nconst wheelRpm = engineRpm / finalRatio; // รอบหมุนที่ล้อจริง\n\n// คำนวณความเร็ว (m/s)\nconst velocityMps = (wheelRpm * Math.PI * diameter) / 60;\n\n// แปลงเป็น (km/h)\nconst velocityKph = velocityMps * 3.6;\n\n// --- ส่งผลลัพธ์ออก (ปัดเศษทิ้งให้เหลือเลขจำนวนเต็ม) ---\nmsg.payload = Math.floor(velocityKph);\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1910,
        "y": 280,
        "wires": [
            [
                "28f9dfb79c75e4b2",
                "89d3b6845d082955"
            ]
        ]
    },

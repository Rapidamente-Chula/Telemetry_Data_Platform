    {
        "id": "6430a5c3467b0cf8",
        "type": "ui-template",
        "z": "74e9e1df8aa29fe1",
        "group": "c9701aa20cfd8dc8",
        "page": "ad3caa33a44b36e6",
        "ui": "",
        "name": "thr_pos",
        "order": 13,
        "width": 1,
        "height": 2,
        "head": "",
        "format": "<template>\n    <div class=\"throttle-grid-1\">\n        <div class=\"label-mini\">THR</div>\n        <div class=\"tank-bg-mini\">\n            <div class=\"tank-fill-mini\" :style=\"{ height: msg.payload + '%' }\"></div>\n        </div>\n        <div class=\"percentage-mini\">{{ msg.payload }}%</div>\n    </div>\n</template>\n\n<style>\n    .throttle-grid-1 {\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        /* สำคัญ: ใช้ width 100% เพื่อให้ขยายเต็ม 1 Grid Unit */\n        width: 100%;\n        padding: 4px 0;\n        box-sizing: border-box;\n    }\n\n    .tank-bg-mini {\n        /* ปรับความกว้างเป็น % หรือระบุค่าที่พอดีกับ 1 Unit (ปกติประมาณ 40-48px) */\n        width: 60%;\n        height: 100px;\n        /* ปรับความสูงตามต้องการ */\n        background: #222;\n        border-radius: 2px;\n        position: relative;\n        overflow: hidden;\n        border: 1px solid #333;\n    }\n\n    /* โค้ดส่วนอื่นๆ คงเดิมจากด้านบน */\n    .label-mini {\n        color: #888;\n        font-size: 10px;\n        font-weight: bold;\n        margin-bottom: 2px;\n    }\n\n    .tank-fill-mini {\n        width: 100%;\n        background: linear-gradient(to top, #00ff88, #50fa7b);\n        position: absolute;\n        bottom: 0;\n        transition: height 0.05s linear;\n    }\n\n    .percentage-mini {\n        margin-top: 4px;\n        font-family: 'Consolas', monospace;\n        font-size: 11px;\n        color: #00ff88;\n    }\n</style>",
        "storeOutMessages": true,
        "passthru": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 2200,
        "y": 480,
        "wires": [
            [
                "fe4b40f75d7f70a9"
            ]
        ]
    },
